{
  "name": "winswift-studio",
  "productName": "WinSwift Studio",
  "version": "1.3.0",
  "description": "Build iPhone apps in Swift and SwiftUI on Windows 10 and 11 - an Xcode-style IDE with an iPhone simulator, live previews and a debugger",
  "main": "main.js",
  "author": "BiNoX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CpMiko2005pl/winswift-studio.git"
  },
  "homepage": "https://github.com/CpMiko2005pl/winswift-studio#readme",
  "bugs": {
    "url": "https://github.com/CpMiko2005pl/winswift-studio/issues"
  },
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "installer-art": "electron scripts/make-installer-art.js",
    "package": "node scripts/package.js",
    "installer": "electron-builder --win nsis --x64",
    "release": "npm run installer && npm run package"
  },
  "keywords": [
    "swift",
    "swiftui",
    "ios",
    "iphone",
    "xcode-alternative",
    "windows",
    "ide",
    "ios-simulator",
    "electron",
    "monaco-editor"
  ],
  "build": {
    "appId": "local.swiftcode.ide",
    "productName": "WinSwift Studio",
    "copyright": "MIT License — WinSwift Studio",
    "asar": false,
    "electronLanguages": [
      "en-US",
      "pl"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/after-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "sim-preload.js",
      "buildtools.js",
      "package.json",
      "LICENSE",
      "runtime/**/*",
      "scripts/fetch-winsdk.js",
      "src/**/*",
      "build/icon.ico",
      "build/icon.png",
      "packaging/Zainstaluj-Swift-i-narzedzia.bat",
      "node_modules/monaco-editor/min/**/*",
      "node_modules/monaco-editor/package.json",
      "node_modules/monaco-editor/LICENSE",
      "node_modules/lucide-static/icons/**/*",
      "node_modules/lucide-static/package.json",
      "node_modules/lucide-static/LICENSE",
      "node_modules/@fontsource/inter/**/*",
      "!node_modules/monaco-editor/{esm,dev,min-maps}/**/*",
      "!node_modules/lucide-static/{font,lib,dist}/**/*",
      "!node_modules/lucide-static/{sprite.svg,tags.json,icon-nodes.json}"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "WinSwift Studio",
      "uninstallDisplayName": "WinSwift Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "WinSwift-Studio-Setup-${version}.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "pl_PL",
        "en_US"
      ],
      "language": "1045",
      "license": "build/license.txt",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "rcedit": "^4.0.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "lucide-static": "^0.460.0",
    "monaco-editor": "^0.52.2"
  }
}
